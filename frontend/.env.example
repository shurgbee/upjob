# WorkOS Dashboard -> API Keys
WORKOS_CLIENT_ID="client_replace_me"
WORKOS_API_KEY="sk_test_replace_me"

# Generate with: openssl rand -base64 24
WORKOS_COOKIE_PASSWORD="replace-with-a-random-value-at-least-32-characters-long"

# Register this exact URL in WorkOS Dashboard -> Redirects
NEXT_PUBLIC_WORKOS_REDIRECT_URI="http://localhost:3000/callback"

# Shared PostgreSQL database and Python resume service (server-only)
POSTGRES_URL="postgresql://user:password@host/database?sslmode=require"
RESUME_BACKEND_URL="http://127.0.0.1:8000"
# Set the same random value in backend/.env; never prefix this with NEXT_PUBLIC_
RESUME_SERVICE_TOKEN="replace-with-a-random-service-token"
