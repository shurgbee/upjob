# --- Database (same TigerCloud instance as the other components) ---
DATABASE_URL=postgres://user:password@host:port/dbname?sslmode=require

# --- Gemini ---
GEMINI_API_KEY=your-key

# Optional: owner of the application rows this agent reconciles. Defaults to the
# sole app_users row when unset.
# UPJOB_USER_ID=00000000-0000-0000-0000-000000000000

# --- Gmail transport ---
# mcp (default): official Google Gmail MCP server. rest: Gmail REST API fallback.
GMAIL_TRANSPORT=mcp

# Google OAuth client (required for GMAIL_TRANSPORT=mcp)
GMAIL_OAUTH_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
GMAIL_OAUTH_CLIENT_SECRET=your-oauth-client-secret
# GMAIL_OAUTH_REDIRECT_PORT=8765
# GMAIL_MCP_URL=https://gmailmcp.googleapis.com/mcp/v1

# For GMAIL_TRANSPORT=rest: path to a Desktop-app OAuth client secret JSON
# downloaded from Google Cloud Console. A token is cached next to it after the
# first interactive consent.
# GMAIL_CLIENT_SECRET_PATH=.gmail_client_secret.json
# GMAIL_TOKEN_PATH=.gmail_token.json
